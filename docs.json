            "icon": "rocket",
            "pages": [
              "launch/create-a-tax-free-token",
              "launch/create-a-tax-token",
              "launch/create-pizza-curve-token",
              "launch/create-a-presale",
              "launch/add-initial-liquidity"
            ]
          },
          {
            "group": "WPizzaDex",
            "icon": "chart-candlestick",
            "pages": [
              "wpizza-dex/what-is-wpizza-dex",
              "wpizza-dex/wpizza-pair",
              "wpizza-dex/wpizza-factory",
              "wpizza-dex/wpizza-router",
              "wpizza-dex/migration-to-pancakeswap"
            ]
