{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "appearance": {
    "default": "light"
  },
  "name": "WPizza Launchpad",
  "description": "Documentation for WPizza — token creation, presales, WPizzaDex, liquidity management, and token locking on BNB Smart Chain.",
  "colors": {
    "primary": "#EAB024",
    "light": "#F5C84C",
    "dark": "#F5B730"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "WPizza App",
          "icon": "rocket",
          "href": "https://wpizza.fun"
        },
        {
          "anchor": "Support",
          "icon": "message-circle",
          "href": "https://t.me/donaopennode"
        },
        {
          "anchor": "Telegram",
          "icon": "send",
          "href": "https://t.me/wpizzachannel"
        },
        {
          "anchor": "Discord",
          "icon": "messages-square",
          "href": "https://discord.gg/bZrAK2zFE"
        },
        {
          "anchor": "OpenNode",
          "icon": "code",
          "href": "https://opennode.dev"
        },
        {
          "anchor": "Community",
          "icon": "globe",
          "href": "https://x.com/wpizzafun"
        }
      ]
    },
    "tabs": [
      {
